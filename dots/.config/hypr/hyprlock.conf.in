# iOS liquid glass - palette shared with waybar / fuzzel / mako.
# Note: `grace` and `no_fade_in` do not exist in hyprlock 0.9.6.

general {
    hide_cursor = true
    ignore_empty_input = true
    fail_timeout = 2000
}

background {
    monitor =
    # Rendered by install.sh and kept in sync by scripts/wallpaper.sh.
    # Never edit the generated hyprlock.conf by hand - edit this template.
    path = @WALLPAPER@
    blur_passes = 3
    blur_size = 9
    brightness = 0.7
    contrast = 1.0
}

# Clock
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgba(f5f5f7ff)
    font_size = 96
    font_family = Inter Display
    position = 0, 210
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = rgba(f5f5f7b3)
    font_size = 22
    font_family = Inter
    position = 0, 120
    halign = center
    valign = center
}

# Input field - fuzzel glass: ffffff1a fill, ffffff40 outline, large radius
input-field {
    monitor =
    size = 390, 72
    outline_thickness = 3
    rounding = 24
    dots_size = 0.26
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgba(ffffff40)
    inner_color = rgba(ffffff1a)
    font_color = rgba(f5f5f7ff)
    check_color = rgba(ffffff80)
    fail_color = rgba(ff453aff)
    fail_text = <span foreground="##ffffffff">$FAIL</span>
    placeholder_text = <span foreground="##ffffff80">Password</span>
    fade_on_empty = false
    position = 0, -45
    halign = center
    valign = center
}
