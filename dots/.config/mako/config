# iOS liquid glass - same palette as fuzzel and waybar.
# Blur is provided by Hyprland: layer_rule namespace "notifications".

font=Inter 16.5
width=495
height=225
margin=15
padding=21,24
border-size=3
border-radius=18

# Waybar dark glass: rgba(20,20,24,0.35) = #14141859
background-color=#14141859
text-color=#f5f5f7ff
border-color=#ffffff40
progress-color=over #ffffff26

anchor=top-right
layer=top
max-visible=4
sort=-time

icons=1
max-icon-size=60
icon-location=left

markup=1
format=<b>%s</b>\n%b
actions=1
default-timeout=5000
ignore-timeout=0

on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=dismiss

history=1
max-history=50

[urgency=low]
text-color=#f5f5f7b3
border-color=#ffffff26
default-timeout=3000

[urgency=normal]
default-timeout=5000

[urgency=critical]
# Same red as #battery.critical in waybar
border-color=#ff453aff
text-color=#ffffffff
background-color=#2a1416cc
default-timeout=0

# Volume and brightness readouts from scripts/volume.sh. They are a glance,
# not a message: one line, no icon, gone in a second, and kept out of history
# so the log is not three hundred volume steps.
#
# The progress fill comes from the int:value hint the script sends -
# progress-color above was already set and simply had nothing feeding it.
[app-name=volume]
format=<b>%s</b>
height=90
width=340
padding=14,20
icons=0
default-timeout=1200
history=0
group-by=app-name

[mode=do-not-disturb]
invisible=1
