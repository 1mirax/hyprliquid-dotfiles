# iOS liquid glass - same palette as fuzzel and waybar.
# Blur is provided by Hyprland: layer_rule namespace "notifications".

font=Inter 16.5
width=495
height=225
margin=15
padding=21,24
border-size=3
border-radius=18

# Kitty's surface: background #14141a at background_opacity 0.72, which is
# 0xB8. Notifications and the terminal are the same dark glass.
#
# fuzzel's white veil (ffffff10) was tried here and fails: on a pale wallpaper
# white-on-white leaves the plate invisible. fuzzel gets away with it because
# it dims the desktop behind itself; a notification cannot.
background-color=#14141ab8
text-color=#f5f5f7ff
border-color=#ffffff40
progress-color=over #ffffff26

anchor=top-right
layer=top
max-visible=4
sort=-time

icons=1
max-icon-size=60
icon-location=left

markup=1
format=<b>%s</b>\n%b
actions=1
default-timeout=5000
ignore-timeout=0

on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=dismiss

history=1
max-history=50

[urgency=low]
text-color=#f5f5f7b3
border-color=#ffffff26
default-timeout=3000

[urgency=normal]
default-timeout=5000

[urgency=critical]
# Same red as #battery.critical in waybar
border-color=#ff453aff
text-color=#ffffffff
background-color=#2a1416cc
default-timeout=0

# Volume and brightness readouts from scripts/osd.sh. They are a glance,
# not a message: one line, no icon, gone in a second, and kept out of history
# so the log is not three hundred volume steps.
#
# The progress fill comes from the int:value hint the script sends -
# progress-color above was already set and simply had nothing feeding it.
[app-name=osd]
format=<b>%s</b>
font=Inter 15
height=64
# Lines the left edge up with the first "|" separator in the bar's right
# group, measured off a screenshot rather than guessed.
#
# The alignment is tied to what modules-right holds and how wide each module
# is. It has already moved once: giving the battery its watts reading pushed
# the separator from x=1624 to x=1586, and this went from 290 to 328 to follow.
# Changing anything in that group means measuring again.
width=328
padding=10,16
# Same 8px the windows keep from the screen edge (general.gaps_out in
# hypr/modules/settings.lua), so the plate lines up with whatever is under it.
# The 18px radius it inherits from the top of this file already matches
# decoration.rounding - the mismatch was only ever the margin.
margin=8
border-size=2
icons=0
# A lighter dark at the same alpha as the ground, so the filled part reads
# brighter without the plate changing density across its width.
#
# Not white, and no "over" prefix: white blended over the ground is what hazed
# the fill milky through several attempts, and "over" is what does the
# blending. Without it the value replaces the background outright.
progress-color=#2c2c38b8
default-timeout=1200
history=0
group-by=app-name

[mode=do-not-disturb]
invisible=1
