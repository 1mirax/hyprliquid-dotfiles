{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  // Pinned, not computed. Waybar sizes the bar to its content, so a glyph that
  // falls back to another font - the spinner in a terminal title, an icon the
  // Nerd Font lacks - changes the line box and the whole bar jumps by a pixel.
  // The content needs 32; 36 gives the strip some air on top of that.
  "height": 36,

  // One flat strip, the way illogical-impulse does it: no per-group islands,
  // groups separated by air rather than by boxes. Only the workspaces keep a
  // background, because the active pill needs something to sit in.
  "modules-left": ["custom/launcher", "hyprland/window"],
  "modules-center": ["cpu", "memory", "temperature", "group/workspaces", "clock", "custom/balance"],
  // Right side reads as four groups, thinnest first: what the machine is
  // running, what you switch, what you connect to, and how long it lasts.
  "modules-right": [
    "tray",
    "custom/sep#1",
    "idle_inhibitor", "backlight", "pulseaudio",
    "custom/sep#2",
    "bluetooth", "network",
    "custom/sep#3",
    "battery"
  ],

  "custom/sep#1": { "format": "|", "tooltip": false },
  "custom/sep#2": { "format": "|", "tooltip": false },
  "custom/sep#3": { "format": "|", "tooltip": false },

  // Invisible counterweight. waybar centres the whole centre group, so the
  // readings left of the pill have to be matched on the right. The clock
  // covers most of it; this makes up the remainder. See the arithmetic in
  // style.css - change either side and the pill drifts.
  "custom/balance": { "format": " ", "tooltip": false },

  "custom/launcher": {
    "format": "<span size='17250'>󰣇</span>",
    "on-click": "fuzzel",
    "tooltip": true,
    "tooltip-format": "Applications"
  },

  "hyprland/window": {
    // fallback="false" keeps Pango from reaching for another font when a title
    // contains a glyph ours lacks - a spinner, an emoji. Those fonts have taller
    // line metrics, and since the bar sizes itself to its content, one such
    // character made the whole strip jump by a pixel or two. The glyph now
    // draws as an empty box instead, and the height never moves.
    // Two things at once, both about the bar not changing height.
    //
    // Waybar sizes the strip to its content, so a glyph our fonts lack makes
    // Pango reach for Noto Sans Mono, whose line metrics are taller, and the
    // whole bar jumps by two pixels. fallback="false" keeps Pango inside our
    // stack - the glyph draws as an empty box and the height never moves.
    // Tested: a smaller font-size does not help (the fallback scales with it)
    // and neither does naming a different fallback family.
    //
    // The rewrite then removes the one glyph that would otherwise show as a
    // box all day: the spinner a terminal puts in its title while a command
    // runs. U+25D0-25D3 are the four phases of it.
    "format": "{title}",
    "max-length": 42,
    "separate-outputs": true,
    "tooltip": false
  },

  // Five custom buttons instead of hyprland/workspaces, which cannot switch
  // workspaces here: it hardcodes `dispatch workspace N`, the Lua config wraps
  // that as invalid Lua and rejects it, and the module offers no on-click to
  // override with. The group keeps them in one container so the pill styling
  // in style.css still has something to sit on.
  //
  // No interval: the compositor raises SIGRTMIN+1 from modules/workspaces.lua
  // whenever a workspace or a window changes, and every button re-runs on it.
  // "once" makes waybar run each exec a single time at startup and then only
  // on the signal.
  "group/workspaces": {
    "orientation": "inherit",
    "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"]
  },

  // The button the laptop needed: while it is on, hypridle neither dims,
  // locks nor suspends. waybar handles the inhibit itself, no script.
  // The button the laptop needed: while it is on, hypridle neither dims,
  // locks nor suspends. waybar handles the inhibit itself, no script.
  //
  // U+F04B2 and U+F04B3 are a drawn pair - the same "zzz" with and without a
  // diagonal strike - so the two states read as one thing switching rather
  // than as two different icons. The moon it replaced has no struck-through
  // counterpart in this font, and faking one with Pango's <s> puts the line
  // across the glyph's advance width, not its shape: at 17px it is invisible.
  // The button the laptop needed: while it is on, hypridle neither dims,
  // locks nor suspends. waybar handles the inhibit itself, no script.
  //
  // The icon shows what sleep is doing, and the colour shows whether that is
  // the normal state: a plain "zzz" in grey means the laptop sleeps as usual,
  // a struck-through one in white means something is holding it awake.
  //
  // Both halves carry the same meaning, which is the point - the strike says
  // "no sleep" and the brightness says "this is not the default".
  //
  // U+F04B2 and U+F04B3 are a drawn pair, the same "zzz" with and without a
  // diagonal strike, so the two states read as one thing switching rather
  // than as two different icons. The moon this replaced has no struck-through
  // counterpart in the font, and faking one with Pango's <s> draws the line
  // across the glyph's advance width rather than its shape: invisible at 17px.
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "<span size='17250'>󰒳</span>",
      "deactivated": "<span size='17250'>󰒲</span>"
    },
    "tooltip-format-activated": "Staying awake - click to allow sleep",
    "tooltip-format-deactivated": "Sleeps normally - click to stay awake"
  },

  // Glyphs verified by rendering them, not by looking them up: U+F00AF is
  // the plain mark, U+F00B1 carries the two dots that read as "connected",
  // and U+F00B2 is the one struck through diagonally. Its neighbours are
  // audio, settings and transfer - all plausible, all wrong.
  //
  // format-disabled used to be an empty string, so switching Bluetooth off
  // made the icon vanish, which is indistinguishable from a bar that lost
  // the module.
  "bluetooth": {
    "format": "<span size='17250'>󰂯</span>",
    "format-off": "<span size='17250'>󰂲</span>",
    "format-disabled": "<span size='17250'>󰂲</span>",
    "format-no-controller": "<span size='17250'>󰂲</span>",
    "format-connected": "<span size='17250'>󰂱</span>",
    "tooltip-format": "Bluetooth on\n{num_connections} connected",
    "tooltip-format-off": "Bluetooth off - click to turn it on",
    "tooltip-format-disabled": "Bluetooth blocked - click to turn it on",
    "tooltip-format-connected": "{device_alias}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/.config/hypr/scripts/bluetooth-menu.sh"
  },

  "cpu": {
    "interval": 2,
    "format": "󰻠 {usage}%",
    "tooltip-format": "CPU load {usage}%",
    "on-click": "alacritty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB",
    "on-click": "alacritty -e btop"
  },

  // hwmon-path-abs is the stable device directory - the hwmonN number under it
  // is reassigned on every boot, so it must not be hardcoded.
  // The glyph is U+F050F, nf-md-thermometer. It used to be U+F110F, which
  // exists in the font too and draws a salt shaker.
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "format": "󰔏 {temperatureC}°",
    "critical-threshold": 90,
    "interval": 5,
    "tooltip-format": "Package {temperatureC}°C\nClick for btop",
    "on-click": "alacritty -e btop"
  },

  // Fixed-length on purpose: %d always pads to two digits and %b is always
  // three letters, so the clock never changes width and never nudges the
  // workspace pill. A weekday or full month name would, since "Sat" and
  // "Wednesday" are not the same width.
  "clock": {
    "format": "{:%H:%M  ·  %d %b}",
    "format-alt": "{:%A, %d %B}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },


  "tray": { "icon-size": 20, "spacing": 10 },

  "pulseaudio": {
    "format": "<span size='17250'>{icon}</span>",
    "format-muted": "<span size='17250'>󰖁</span>",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "~/.config/hypr/scripts/audio-menu.sh",
    "tooltip-format": "Volume {volume}% - right-click to pick a device",
    "scroll-step": 5,
    // Above 100 the signal is amplified past what the hardware puts out, which
    // is the only way to make a quietly mastered film audible. Matches the
    // -l 1.5 ceiling on the volume keys; leaving this at its default of 100
    // would let the keys go higher than the scroll wheel could.
    "max-volume": 150,
    "states": { "boosted": 101 }
  },

  // Scrolling changes it, the tooltip says by how much, and a click jumps to
  // full. Before this it displayed an icon and did nothing else.
  "backlight": {
    "format": "<span size='17250'>{icon}</span>",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "brightnessctl set 100%",
    "tooltip-format": "Brightness {percent}% - scroll to change, click for full"
  },

  // Three states, one glyph family, each verified by rendering it.
  //
  //   󰤮  U+F092E  struck through - the adapter is off or rfkill'd
  //   󰤯  U+F092F  empty outline  - radio on, nothing connected
  //   󰤟󰤢󰤥󰤨  four steps    - connected, fill shows signal
  //
  // format-disabled was missing, so turning the radio off fell through to the
  // bare "format" and rendered nothing: the icon vanished and the module
  // collapsed to zero width, which looked like a bug rather than a state.
  //
  // U+F092F is deliberately no longer the ladder's zero. Reserving it for
  // "not connected" keeps the three states distinct - a full ladder means
  // connected, always.
  "network": {
    "format": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "<span size='17250'>{icon}</span>",
    "format-ethernet": "<span size='17250'>󰌘</span>",
    "format-disconnected": "<span size='17250'>󰤯</span>",
    "format-disabled": "<span size='17250'>󰤮</span>",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "Wired  {ipaddr}",
    "tooltip-format-disconnected": "Not connected - click to pick a network",
    "tooltip-format-disabled": "Wi-Fi is off - F8 or click to turn it on",
    "interval": 3,
    "on-click": "networkmanager_dmenu"
  },

  // The twenty-glyph ladder is gone. A battery icon that fills up says the
  // same thing the percentage right next to it already says; an arrow says
  // what the percentage cannot - which way it is going, and how fast.
  //
  // Plain U+2193 and U+2191 rather than Nerd Font arrows: the md- codepoints
  // that look right in a table render as an up arrow and a broken circle here,
  // checked by drawing them. These two are in Inter, at the right weight.
  //
  // "plugged" is not a rare state on this machine: the charge threshold stops
  // at 80%, so sitting on AC at 80% and not charging is the normal desk case.
  // It says AC rather than carrying a glyph for it.
  "battery": {
    "format": "{capacity}% ↓{power:.0f}W",
    "format-discharging": "{capacity}% ↓{power:.0f}W",
    "format-charging": "{capacity}% ↑{power:.0f}W",
    "format-plugged": "{capacity}% AC",
    "format-full": "{capacity}% AC",
    "tooltip-format-discharging": "{power:.1f} W draw - {time} left\n{cycles} cycles, {health}% health",
    "tooltip-format-charging": "{power:.1f} W in - {time} to full\n{cycles} cycles, {health}% health",
    "interval": 5,
    "states": { "warning": 20, "critical": 10 }
  },

  "custom/ws1": {
    "exec": "~/.config/hypr/scripts/workspace.sh 1",
    "return-type": "json",
    "signal": 1,
    "interval": "once",
    "on-click": "~/.config/hypr/scripts/workspace.sh focus 1",
    "tooltip": false
  },
  "custom/ws2": {
    "exec": "~/.config/hypr/scripts/workspace.sh 2",
    "return-type": "json",
    "signal": 1,
    "interval": "once",
    "on-click": "~/.config/hypr/scripts/workspace.sh focus 2",
    "tooltip": false
  },
  "custom/ws3": {
    "exec": "~/.config/hypr/scripts/workspace.sh 3",
    "return-type": "json",
    "signal": 1,
    "interval": "once",
    "on-click": "~/.config/hypr/scripts/workspace.sh focus 3",
    "tooltip": false
  },
  "custom/ws4": {
    "exec": "~/.config/hypr/scripts/workspace.sh 4",
    "return-type": "json",
    "signal": 1,
    "interval": "once",
    "on-click": "~/.config/hypr/scripts/workspace.sh focus 4",
    "tooltip": false
  },
  "custom/ws5": {
    "exec": "~/.config/hypr/scripts/workspace.sh 5",
    "return-type": "json",
    "signal": 1,
    "interval": "once",
    "on-click": "~/.config/hypr/scripts/workspace.sh focus 5",
    "tooltip": false
  }
}
